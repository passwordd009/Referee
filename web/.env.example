# Supabase — get from your project dashboard (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Game server (Socket.IO + REST)
VITE_SERVER_URL=http://localhost:3001

# LiveKit — player-to-player video. Leave empty to disable video
# between players (laugh detection still works — it runs locally).
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Minimum age required to create an account (default 13)
VITE_MIN_AGE=13
